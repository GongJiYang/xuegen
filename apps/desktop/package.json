{
  "name": "xuegen-desktop",
  "version": "0.11.0",
  "description": "Xuegen desktop shell: a sandboxed Electron window that streams a Xuegen agent session.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --config electron-builder.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "smoke": "tsx src/agent/smoke.ts"
  },
  "dependencies": {
    "@animate-ui/react": "2.4.2",
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "motion": "14.9.1",
    "radix-ui": "1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "39.8.10",
    "electron-builder": "26.0.12",
    "electron-vite": "2.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "hast-util-to-jsx-runtime": "2.3.7",
    "jsdom": "25.0.1",
    "katex": "0.16.47",
    "mermaid": "11.17.2",
    "prettier": "3.9.10",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "streamdown": "1.6.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unified": "11.0.5",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
